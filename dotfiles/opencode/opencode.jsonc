{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "permission": "allow",
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "notion": {
      "type": "remote",
      "url": "https://mcp.notion.com/mcp",
      "enabled": true
    },
    "datadog": {
      "type": "remote",
      "url": "https://mcp.us5.datadoghq.com/v1/mcp",
      "enabled": true
    },
    "plenful": {
      "type": "remote",
      "url": "https://connectors.staging.plenful.com/mcp",
      "oauth": {
        "redirectUri": "http://localhost:19876/mcp/oauth/callback"
      },
      "enabled": true
    }
  },
  "agent": {
    "plan": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    },
    "scout": {
      "disable": true
    }
  }
}
