{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    }
  },
  "agent": {
    "general": {
      "model": "openai/gpt-5.6-luna-fast",
      "variant": "none"
    },
    "explore": {
      "model": "openai/gpt-5.6-luna-fast",
      "variant": "none"
    },
    "scout": {
      "model": "openai/gpt-5.6-luna-fast",
      "variant": "none"
    }
  }
}
