// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cursor_animation": {
    "enabled": false
  },
  "icon_theme": "Zed (Default)",
  "show_edit_predictions": false,
  "completions": {
    "lsp": true
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "agent": {
    "sandbox_permissions": {
      "allow_unsandboxed": true,
      "network_hosts": [
        "spacetimedb.com",
        "docs.restate.dev",
        "obelisk.run",
        "github.com",
        "raw.githubusercontent.com"
      ]
    },
    "default_profile": "write",
    "flexible": false,
    "dock": "right",
    "show_turn_stats": true,
    "tool_permissions": {
      "tools": {
        "copy_path": {
          "default": "allow"
        },
        "fetch": {
          "default": "allow"
        },
        "restore_file_from_disk": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^cd\\s+py(\\s|$)"
            }
          ]
        }
      }
    },
    "default_model": {
      "effort": "low",
      "provider": "openai-subscribed",
      "model": "gpt-6.1-sol",
      "enable_thinking": true
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "language_models": {
    "openai_compatible": {

    }
  },
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "effort": "medium",
        "model": "openai/gpt-5.6-sol"
      },
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "tab_bar": {
    "show": false
  },
  "title_bar": {
    "show_sign_in": false
  },
  "disable_ai": false,
  "telemetry": {
    "diagnostics": true,
    "metrics": false
  },
  "vim_mode": true,
  "ui_font_size": 15.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark Hard"
  }
}
