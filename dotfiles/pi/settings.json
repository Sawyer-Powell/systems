{
  "defaultProvider": "anthropic",
  "defaultModel": "claude-sonnet-5-5",
  "defaultThinkingLevel": "high",
  "defaultTools": [
    "+codemode"
  ],
  "hideThinkingBlock": true,
  "agents": {
    "models": {
      "fast": {
        "provider": "anthropic",
        "model": "claude-sonnet-5-5",
        "thinking": "low"
      },
      "deliberate": {
        "provider": "anthropic",
        "model": "claude-sonnet-5-5",
        "thinking": "high"
      }
    },

    "maxDepth": 3
  },
  "collapseChangelog": true,
  "theme": "gruvbox-dark",
  "quietStartup": true,
  "httpIdleTimeoutMs": 120000,
  "lastChangelogVersion": "1.4.0"
}