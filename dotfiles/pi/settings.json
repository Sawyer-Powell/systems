{
  "defaultProvider": "openrouter",
  "defaultModel": "deepseek/deepseek-v4.1-flash-1017",
  "defaultThinkingLevel": "high",
  "defaultTools": [
    "+codemode"
  ],
  "hideThinkingBlock": true,
  "agents": {
    "models": {
      "fast": {
        "provider": "anthropic",
        "model": "claude-sonnet-5-5",
        "thinking": "low"
      },
      "deliberate": {
        "provider": "anthropic",
        "model": "claude-sonnet-5-5",
        "thinking": "high"
      }
    },
    "maxDepth": 3
  },
  "collapseChangelog": true,
  "theme": "system",
  "quietStartup": true
}
